# EAS Build upload exclusions — slim down the 45 MB upload to speed up
# compression, fingerprinting, and queue ingestion. Anything regenerated
# during `expo prebuild` or not needed by the iOS/Android native build
# belongs here.

# ───── Build artefacts (regenerated by prebuild) ─────
ios/
android/
dist/
web-build/
build/

# ───── Cache directories ─────
.metro-cache/
.expo/
.expo-shared/
.next/
.cache/
node_modules/.cache/

# ───── Test & coverage output ─────
coverage/
.nyc_output/
__tests__/
__mocks__/
*.test.ts
*.test.tsx
*.test.js
*.test.jsx
*.spec.ts
*.spec.tsx
*.spec.js
*.spec.jsx

# ───── Editor / OS noise ─────
.vscode/
.idea/
.DS_Store
*.swp
*.swo
Thumbs.db

# ───── Logs ─────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
expo-debug.log*

# ───── Source maps & misc ─────
*.map
*.tsbuildinfo

# ───── Documentation (not needed in build) ─────
docs/
*.md
!README.md

# ───── Misc dev-only configs (Expo/EAS reads these from defaults) ─────
.eslintcache
